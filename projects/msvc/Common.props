<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- Shared settings for every PocketChess MSVC project (build doc §3.1). -->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</RepoRoot>
    <OutDir>$(RepoRoot)out\msvc\$(Configuration)\</OutDir>
    <IntDir>$(RepoRoot)out\msvc\obj\$(ProjectName)\$(Configuration)\</IntDir>
    <!-- F5 from a fresh checkout: the app finds its data beside the executable (Enigmistica lesson). -->
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <!-- Shared Zig/InkView toolchain (D3): -ToolchainRoot, %POCKETBOOK_TOOLCHAIN_ROOT%, ..\..\libs\pocketbook -->
    <PocketBookToolchainRoot Condition="'$(PocketBookToolchainRoot)'=='' and '$(POCKETBOOK_TOOLCHAIN_ROOT)'!=''">$(POCKETBOOK_TOOLCHAIN_ROOT)</PocketBookToolchainRoot>
    <PocketBookToolchainRoot Condition="'$(PocketBookToolchainRoot)'==''">$([System.IO.Path]::GetFullPath('$(RepoRoot)..\..\libs\pocketbook'))</PocketBookToolchainRoot>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <!-- Precise, no FMA contraction: the canvas must be bit-identical to the ARM build (golden checksums). -->
      <FloatingPointModel>Precise</FloatingPointModel>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 /Zc:__cplusplus /Zc:preprocessor %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>NOMINMAX;WIN32_LEAN_AND_MEAN;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(RepoRoot)src;$(RepoRoot)libs\sqlite;$(RepoRoot)libs\nanosvg;$(RepoRoot)libs\sdl3\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'!='Release'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
</Project>
