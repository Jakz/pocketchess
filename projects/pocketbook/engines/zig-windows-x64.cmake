# Toolchain for Windows x64 engine builds with Zig (build doc §4.3): same compiler family as
# the ARM build, so the engine sources are exercised identically on both targets.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(NOT ZIG_EXE)
    set(ZIG_EXE "$ENV{ZIG_EXE}")
endif()
if(NOT ZIG_EXE)
    message(FATAL_ERROR "ZIG_EXE not set")
endif()
set(CMAKE_C_COMPILER "${ZIG_EXE}" CACHE FILEPATH "" FORCE)
set(CMAKE_C_COMPILER_ARG1 "cc")
set(CMAKE_CXX_COMPILER "${ZIG_EXE}" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER_ARG1 "c++")
set(CMAKE_C_FLAGS_INIT "-target x86_64-windows-gnu")
set(CMAKE_CXX_FLAGS_INIT "-target x86_64-windows-gnu")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-target x86_64-windows-gnu")
set(CMAKE_AR "${ZIG_EXE}" CACHE FILEPATH "" FORCE)
set(CMAKE_RANLIB "${ZIG_EXE}" CACHE FILEPATH "" FORCE)
set(CMAKE_C_ARCHIVE_CREATE "<CMAKE_AR> ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_CXX_ARCHIVE_CREATE "<CMAKE_AR> ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_C_ARCHIVE_FINISH "<CMAKE_RANLIB> ranlib <TARGET>")
set(CMAKE_CXX_ARCHIVE_FINISH "<CMAKE_RANLIB> ranlib <TARGET>")
